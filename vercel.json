{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...all]?path=:path*" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
